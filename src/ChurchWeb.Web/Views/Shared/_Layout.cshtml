@using ChurchWeb.Web.Models.Home
@inject NavMenuVm NavMenu

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 안디옥 교회</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700;900&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="site" id="site">

    <header class="site-header" id="siteHeader">
        <div class="container">
            <a href="/" class="brand">
                <span class="mark">합동<br>총회</span>
                <span class="bt">안디옥 교회<small>대한예수교장로회(합동)</small></span>
            </a>
            <div class="navcenter">
                <nav class="nav">
                    @foreach (var menuItem in NavMenu.MenuItems)
                    {
                        <a href="@menuItem.Url">@menuItem.Title</a>
                    }
                </nav>
                <div class="mega">
                    <div class="cols">
                        @foreach (var menuItem in NavMenu.MenuItems)
                        {
                            <div class="col">
                                <h4>@menuItem.Title</h4>
                                @foreach (var subItem in menuItem.SubItems)
                                {
                                    <a href="@subItem.Url">@subItem.Title</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="header-right">
                <button class="theme-toggle" id="themeToggle" title="라이트/다크 전환">☾</button>
                <button class="hamb" aria-label="메뉴">≡</button>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="fbrand">안디옥 교회</div>
            <div>주소 : ○○시 ○○구 ○○로 1, 304호 · 전화 : 02-000-0000 · 이메일 : church@@example.com</div>
            <div>COPYRIGHT © 안디옥 교회 · 대한예수교장로회(합동) ALL RIGHTS RESERVED. · 온라인 전도카드는 별도 QR/단축 URL로 제공</div>
        </div>
    </footer>

</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
