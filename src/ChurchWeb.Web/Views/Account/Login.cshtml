@model ChurchWeb.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "관리자 로그인";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChurchWeb</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap" />
    <style>
        *{box-sizing:border-box;margin:0;padding:0}
        body{
            min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;
            background:#f5f3ee;color:#2b2620;
            font-family:'Noto Sans KR',sans-serif;-webkit-font-smoothing:antialiased;
        }
        .login-container{
            width:100%;max-width:380px;background:#fff;
            border:1px solid #e3ddd1;border-top:3px solid #2E1F16;
            padding:40px 36px 32px;
        }
        .login-header{margin-bottom:32px}
        .login-header h1{font-family:'Noto Serif KR',serif;font-size:24px;font-weight:700;color:#2E1F16}
        .login-header p{margin-top:6px;font-size:13.5px;color:#8a8377}
        .mb-3{margin-bottom:18px}
        .form-label{display:block;font-size:13px;font-weight:700;color:#2E1F16;margin-bottom:7px}
        .form-control{
            display:block;width:100%;padding:11px 12px;font:inherit;font-size:14.5px;color:#2b2620;
            background:#fff;border:1px solid #d9d2c4;border-radius:2px;
        }
        .form-control::placeholder{color:#b3aa9b}
        .form-control:focus{outline:none;border-color:#A67C3D;box-shadow:inset 0 0 0 1px #A67C3D}
        .form-check{display:flex;align-items:center;gap:8px}
        .form-check-input{width:15px;height:15px;accent-color:#2E1F16}
        .form-check-label{font-size:13.5px;color:#5c544a}
        .btn-login{
            display:block;width:100%;margin-top:8px;padding:12px;
            font:inherit;font-size:15px;font-weight:700;color:#F3E7CF;
            background:#2E1F16;border:0;border-radius:2px;cursor:pointer;
        }
        .btn-login:hover{background:#3d2a1e}
        .alert{margin-bottom:20px;padding:12px 14px;font-size:13px;color:#8a3b2f;background:#fbf1ee;border-left:3px solid #8a3b2f}
        .alert ul{list-style:none}
        .text-danger{display:block;margin-top:5px;font-size:12.5px;color:#8a3b2f}
        .back-home{margin-top:28px;padding-top:18px;border-top:1px solid #ece7dd}
        .back-home a{font-size:13px;color:#8a8377;text-decoration:none}
        .back-home a:hover{color:#2E1F16}
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>관리자 로그인</h1>
            <p>ChurchWeb 관리 시스템</p>
        </div>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger" role="alert">
                <div asp-validation-summary="All" class="text-danger"></div>
            </div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" placeholder="사용자 이름" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="비밀번호" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary btn-login">로그인</button>
        </form>

        <div class="back-home">
            <a href="/">← 홈페이지로 돌아가기</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
