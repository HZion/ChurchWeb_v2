@model ChurchWeb.Web.Models.News.BulletinListVm
@{
    ViewData["Title"] = Model.PageTitle;
}

<partial name="_PageHero" model='($"홈 &nbsp;›&nbsp; 소식 &nbsp;›&nbsp; <b>{Model.PageTitle}</b>", Model.PageTitle, Model.PageSubtitle)' />
<partial name="_SubNav" model='((IEnumerable<object>)Model.Tabs, "bulletins")' />

<main class="content">
    <div class="container">

        @if (Model.Items.Count == 0)
        {
            <!-- 빈 상태 -->
            <div class="empty-state">
                <div class="empty-icon">📖</div>
                <h3>아직 등록된 주보가 없습니다</h3>
                <p>곧 업데이트될 예정입니다. 조금만 기다려주세요.</p>
            </div>
        }
        else
        {
            <!-- 툴바 (개수) -->
            <div class="toolbar">
                <div class="count">총 <b>@Model.TotalCount</b>건의 주보</div>
            </div>

            <!-- 주보 카드 그리드 -->
            <div class="bulletin-grid">
                @foreach (var item in Model.Items)
                {
                    <div class="bulletin-card">
                        <a href="/news/bulletins/@item.Id" class="cover">
                            <div class="cover-img">
                                <img src="@item.CoverUrl" alt="@item.Title" loading="lazy" />
                            </div>
                            <div class="badge">주보</div>
                        </a>
                        <div class="b">
                            <div class="title">@item.Title</div>
                            <div class="actions">
                                <a href="/news/bulletins/@item.Id" class="btn-view">보기</a>
                                <a href="@item.FileUrl" class="btn-down" download>다운로드</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- 페이지네이션 -->
            @if (Model.TotalPages > 1)
            {
                <div class="pagination">
                    @if (Model.Page > 1)
                    {
                        <a href="?page=@(Model.Page - 1)" class="page-link">‹ 이전</a>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a href="?page=@i" class="page-link @(i == Model.Page ? "active" : "")">@i</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a href="?page=@(Model.Page + 1)" class="page-link">다음 ›</a>
                    }
                </div>
            }
        }

    </div>
</main>
