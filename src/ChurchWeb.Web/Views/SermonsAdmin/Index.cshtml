@model ChurchWeb.Web.Models.Admin.SermonListViewModel
@{
    ViewData["Title"] = "설교 관리";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1>설교 관리</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin">대시보드</a></li>
                    <li class="breadcrumb-item active">설교 관리</li>
                </ol>
            </nav>
        </div>
        <div>
            <a href="/Admin/Sermons/Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> 새 설교 등록
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter & Search -->
<div class="admin-card mb-3">
    <form method="get" action="/Admin/Sermons">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" name="searchTerm" class="form-control" placeholder="제목, 설교자, 본문 검색" value="@Model.Filter.SearchTerm" />
            </div>
            <div class="col-md-2">
                <select name="category" class="form-select">
                    <option value="">전체 분류</option>
                    <option value="sunday" selected="@(Model.Filter.Category == "sunday")">주일설교</option>
                    <option value="special" selected="@(Model.Filter.Category == "special")">특별설교</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="isVisible" class="form-select">
                    <option value="">전체 표시</option>
                    <option value="true" selected="@(Model.Filter.IsVisible == true)">표시</option>
                    <option value="false" selected="@(Model.Filter.IsVisible == false)">숨김</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sortBy" class="form-select">
                    <option value="PreachedOn" selected="@(Model.Filter.SortBy == "PreachedOn")">설교일</option>
                    <option value="Title" selected="@(Model.Filter.SortBy == "Title")">제목</option>
                    <option value="Preacher" selected="@(Model.Filter.SortBy == "Preacher")">설교자</option>
                    <option value="Category" selected="@(Model.Filter.SortBy == "Category")">분류</option>
                    <option value="SortOrder" selected="@(Model.Filter.SortBy == "SortOrder")">순서</option>
                </select>
            </div>
            <div class="col-md-2">
                <div class="btn-group w-100" role="group">
                    <button type="submit" class="btn btn-primary">검색</button>
                    <a href="/Admin/Sermons" class="btn btn-secondary">초기화</a>
                </div>
            </div>
        </div>
        <input type="hidden" name="sortDescending" value="@Model.Filter.SortDescending" />
    </form>
</div>

<!-- Sermon List -->
<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0">설교 목록 (@Model.Pagination.TotalCount 개)</h5>
    </div>

    @if (Model.Sermons.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">순서</th>
                        <th>제목</th>
                        <th style="width: 120px;">본문</th>
                        <th style="width: 100px;">설교자</th>
                        <th style="width: 110px;">설교일</th>
                        <th style="width: 90px;">분류</th>
                        <th style="width: 80px;">표시</th>
                        <th style="width: 180px;" class="text-center">관리</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sermon in Model.Sermons)
                    {
                        <tr id="sermon-@sermon.Id">
                            <td class="text-center">
                                <span class="badge bg-secondary">@sermon.SortOrder</span>
                            </td>
                            <td>
                                <div class="fw-semibold">@sermon.Title</div>
                                @if (!string.IsNullOrEmpty(sermon.YoutubeUrl))
                                {
                                    <small class="text-muted">
                                        <i class="bi bi-youtube"></i> 동영상
                                    </small>
                                }
                            </td>
                            <td><small class="text-muted">@sermon.Verse</small></td>
                            <td>@sermon.Preacher</td>
                            <td>@sermon.PreachedOn.ToString("yyyy.MM.dd")</td>
                            <td>
                                <span class="badge bg-@(sermon.Category == "sunday" ? "primary" : "info")">
                                    @sermon.CategoryDisplay
                                </span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-@(sermon.IsVisible ? "success" : "secondary") toggle-visibility"
                                        data-id="@sermon.Id" data-visible="@sermon.IsVisible.ToString().ToLower()">
                                    @(sermon.IsVisible ? "표시" : "숨김")
                                </button>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="/Admin/Sermons/Edit/@sermon.Id" class="btn btn-outline-primary" title="수정">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger delete-sermon" data-id="@sermon.Id" title="삭제">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.Pagination.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Pagination.HasPrevious ? "" : "disabled")">
                        <a class="page-link" href="?page=@(Model.Pagination.CurrentPage - 1)@GetQueryString()">이전</a>
                    </li>

                    @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i@GetQueryString()">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.Pagination.HasNext ? "" : "disabled")">
                        <a class="page-link" href="?page=@(Model.Pagination.CurrentPage + 1)@GetQueryString()">다음</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <p class="text-muted">등록된 설교가 없습니다.</p>
            <a href="/Admin/Sermons/Create" class="btn btn-primary">첫 설교 등록하기</a>
        </div>
    }
</div>

@functions {
    string GetQueryString()
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(Model.Filter.SearchTerm))
            query.Add($"searchTerm={Model.Filter.SearchTerm}");
        if (!string.IsNullOrEmpty(Model.Filter.Category))
            query.Add($"category={Model.Filter.Category}");
        if (Model.Filter.IsVisible.HasValue)
            query.Add($"isVisible={Model.Filter.IsVisible.Value}");
        query.Add($"sortBy={Model.Filter.SortBy}");
        query.Add($"sortDescending={Model.Filter.SortDescending}");
        return query.Any() ? "&" + string.Join("&", query) : "";
    }
}

@section Scripts {
    <script>
        // Toggle visibility
        document.querySelectorAll('.toggle-visibility').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.dataset.id;
                const response = await fetch(`/Admin/Sermons/ToggleVisibility/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        location.reload();
                    }
                }
            });
        });

        // Delete sermon
        document.querySelectorAll('.delete-sermon').forEach(btn => {
            btn.addEventListener('click', async function() {
                if (!confirm('이 설교를 삭제하시겠습니까?')) return;

                const id = this.dataset.id;
                const response = await fetch(`/Admin/Sermons/Delete/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        document.getElementById(`sermon-${id}`).remove();
                        alert(data.message);
                    } else {
                        alert(data.message);
                    }
                }
            });
        });
    </script>
}
