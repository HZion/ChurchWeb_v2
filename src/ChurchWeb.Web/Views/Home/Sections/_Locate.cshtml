@model ChurchWeb.Web.Models.Home.LocateVm

<section class="locate" id="locate">
    <div class="container">
        <div class="row">
            <div class="vlabel">오시는 길</div>
            <div>
                <div class="addr">@Model.Address</div>
                <div class="lines">
                    전화 : @Model.Phone<br>
                    예배 : @Model.WorshipSchedule<br>
                    온라인 헌금 : @Model.BankAccount
                </div>
            </div>
        </div>
    </div>
    <div class="map">
        <div id="home-kakao-map" style="width:100%;height:100%"></div>
    </div>
</section>
