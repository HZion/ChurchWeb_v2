@model ChurchWeb.Web.Models.Home.VisionVm

<section class="vision" id="vision">
    <div class="container">
        <div class="year">@Model.Year · 올해의 표어</div>
        <div class="motto"><span class="q">"</span>@Model.Motto<span class="q">"</span></div>
        <div class="practice">
            @foreach (var item in Model.Practices)
            {
                <div>
                    <div class="n">@item.Number</div>
                    <div class="t">@item.Text</div>
                </div>
            }
        </div>
    </div>
</section>
