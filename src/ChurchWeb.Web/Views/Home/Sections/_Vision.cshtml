@model ChurchWeb.Web.Models.Home.VisionVm

<section class="vision" id="vision">
    <div class="container">
        <div class="year">@Model.Year · 올해의 표어</div>
        <h2 class="motto">@Model.Motto</h2>
        <div class="rule"></div>
        <ol class="practice">
            @foreach (var item in Model.Practices)
            {
                <li>
                    <span class="n">@item.Number</span>
                    <span class="t">@item.Text</span>
                </li>
            }
        </ol>
    </div>
</section>
