@model ChurchWeb.Web.Models.Admin.ChurchInfoViewModel
@{
    ViewData["Title"] = "기본 관리";
    Layout = "_AdminLayout";
}

<div class="page-head">
    <h2 class="serif">기본 관리</h2>
    <p>메인 화면의 표어·실천사항·홍보 영상을 코드 수정 없이 변경합니다.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="split">
        <div class="card" style="flex:1;min-width:420px">
            <h3>비전 섹션 · 올해의 표어</h3>
            <div class="sub">1년마다 바뀌는 표어와 생활 실천 내용을 입력하세요. 메인 화면에 명조체로 강조 표시됩니다.</div>

            <div class="field">
                <label asp-for="Year">연도</label>
                <input asp-for="Year" type="text" placeholder="2026년" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="VisionMotto">올해의 표어</label>
                <input asp-for="VisionMotto" type="text" placeholder="말씀 위에 굳게 서는 교회" />
                <span asp-validation-for="VisionMotto" class="text-danger"></span>
            </div>

            <div class="field">
                <label>생활 실천 내용 <span class="hint">줄바꿈으로 항목 구분</span></label>
                <textarea asp-for="Practices" rows="5" placeholder="1. 날마다 말씀을 묵상합니다&#10;2. 이웃을 내 몸과 같이 섬깁니다&#10;3. 기쁨으로 예배에 참여합니다"></textarea>
                <span asp-validation-for="Practices" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="PromoVideoUrl">메인 홍보 영상 (유튜브 URL)</label>
                <input asp-for="PromoVideoUrl" type="url" placeholder="https://youtu.be/xxxxxxxxxxx" />
                <span asp-validation-for="PromoVideoUrl" class="text-danger"></span>
            </div>

            <div class="flex-end">
                <button type="button" class="btn ghost" onclick="location.reload()">되돌리기</button>
                <button type="submit" class="btn primary">저장하기</button>
            </div>
        </div>

        <div class="card" style="width:340px">
            <h3>미리보기</h3>
            <div class="sub">메인 비전 섹션 표시 예시</div>
            <div style="background:var(--charcoal);border-radius:12px;padding:28px 22px;text-align:center">
                <div style="color:var(--gold-soft);font-size:12px;letter-spacing:.2em" id="preview-year">@Model.Year VISION</div>
                <div class="serif" style="color:#fff;font-size:20px;margin:12px 0;line-height:1.4" id="preview-motto">
                    @if (!string.IsNullOrEmpty(Model.VisionMotto))
                    {
                        @foreach (var line in Model.VisionMotto.Split('\n'))
                        {
                            @line<br />
                        }
                    }
                    else
                    {
                        <text>말씀 위에 굳게<br>서는 교회</text>
                    }
                </div>
                <div style="height:1px;background:rgba(212,185,150,.35);margin:16px 0"></div>
                <div style="color:#cabfa9;font-size:12px;line-height:1.9;text-align:left" id="preview-practices">
                    @if (!string.IsNullOrEmpty(Model.Practices))
                    {
                        @foreach (var line in Model.Practices.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)))
                        {
                            @line<br />
                        }
                    }
                    else
                    {
                        <text>1. 날마다 말씀을 묵상합니다<br>
                        2. 이웃을 내 몸과 같이 섬깁니다<br>
                        3. 기쁨으로 예배에 참여합니다</text>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 추가 정보 섹션 (접을 수 있게) -->
    <div class="card mt">
        <h3>추가 교회 정보</h3>
        <div class="sub">기본 정보, 연락처, 예배 시간 등을 관리합니다.</div>

        <div class="grid g2">
            <div class="field">
                <label asp-for="ChurchName">교회명</label>
                <input asp-for="ChurchName" type="text" />
                <span asp-validation-for="ChurchName" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Denomination">교단</label>
                <input asp-for="Denomination" type="text" placeholder="예: 대한예수교장로회(합동)" />
            </div>

            <div class="field">
                <label asp-for="Address">주소</label>
                <input asp-for="Address" type="text" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Phone">전화번호</label>
                <input asp-for="Phone" type="text" placeholder="02-1234-5678" />
            </div>

            <div class="field">
                <label asp-for="Email">이메일</label>
                <input asp-for="Email" type="email" />
            </div>

            <div class="field">
                <label asp-for="YoutubeUrl">유튜브 채널</label>
                <input asp-for="YoutubeUrl" type="url" placeholder="https://youtube.com" />
            </div>
        </div>

        <div class="field">
            <label asp-for="OnlineOfferingAccount">온라인 헌금 계좌</label>
            <input asp-for="OnlineOfferingAccount" type="text" placeholder="○○은행 000-00-00000 (안디옥 교회)" />
        </div>

        <div class="field">
            <label asp-for="WorshipTimesJson">예배 시간</label>
            <input asp-for="WorshipTimesJson" type="text" placeholder="주일 1부 09:00 · 2부 11:00 · 수요 19:30" />
            <small class="text-muted">예배 시간을 간단한 텍스트로 입력하세요</small>
        </div>

        <div class="flex-end">
            <button type="submit" class="btn primary">저장하기</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        // 실시간 미리보기 업데이트
        document.querySelector('input[name="Year"]').addEventListener('input', function(e) {
            document.getElementById('preview-year').textContent = e.target.value + ' VISION';
        });

        document.querySelector('input[name="VisionMotto"]').addEventListener('input', function(e) {
            const text = e.target.value || '말씀 위에 굳게<br>서는 교회';
            document.getElementById('preview-motto').innerHTML = text.replace(/\n/g, '<br>');
        });

        document.querySelector('textarea[name="Practices"]').addEventListener('input', function(e) {
            const lines = e.target.value.split('\n').filter(l => l.trim());
            if (lines.length > 0) {
                document.getElementById('preview-practices').innerHTML = lines.join('<br>');
            } else {
                document.getElementById('preview-practices').innerHTML =
                    '1. 날마다 말씀을 묵상합니다<br>2. 이웃을 내 몸과 같이 섬깁니다<br>3. 기쁨으로 예배에 참여합니다';
            }
        });
    </script>
}
