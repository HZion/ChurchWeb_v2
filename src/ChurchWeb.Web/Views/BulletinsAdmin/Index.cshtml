@model ChurchWeb.Web.Models.Admin.BulletinListViewModel
@{
    ViewData["Title"] = "주보 관리";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1>주보 관리</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin">대시보드</a></li>
                    <li class="breadcrumb-item active">주보 관리</li>
                </ol>
            </nav>
        </div>
        <a href="/Admin/Bulletins/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> 주보 등록
        </a>
    </div>
</div>

<!-- 검색 및 필터 -->
<div class="admin-card mb-3">
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <input type="text" name="searchTerm" class="form-control" placeholder="제목 또는 파일명 검색" value="@Model.Filter.SearchTerm" />
        </div>
        <div class="col-md-2">
            <select name="isVisible" class="form-select">
                <option value="">전체</option>
                <option value="true" selected="@(Model.Filter.IsVisible == true)">공개</option>
                <option value="false" selected="@(Model.Filter.IsVisible == false)">비공개</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sortBy" class="form-select">
                <option value="PublishedDate" selected="@(Model.Filter.SortBy == "PublishedDate")">발행일</option>
                <option value="Title" selected="@(Model.Filter.SortBy == "Title")">제목</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sortDescending" class="form-select">
                <option value="true" selected="@Model.Filter.SortDescending">내림차순</option>
                <option value="false" selected="@(!Model.Filter.SortDescending)">오름차순</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary w-100">검색</button>
        </div>
    </form>
</div>

<!-- 주보 목록 -->
<div class="admin-card">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>제목</th>
                    <th>발행일</th>
                    <th>파일명</th>
                    <th>크기</th>
                    <th>상태</th>
                    <th>작업</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Bulletins.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">등록된 주보가 없습니다.</td>
                    </tr>
                }
                else
                {
                    foreach (var bulletin in Model.Bulletins)
                    {
                        <tr>
                            <td>@bulletin.Title</td>
                            <td>@bulletin.PublishedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <a href="/Admin/Bulletins/Download/@bulletin.Id" class="text-decoration-none">
                                    <i class="bi bi-file-pdf"></i> @bulletin.FileName
                                </a>
                            </td>
                            <td>@bulletin.FileSizeDisplay</td>
                            <td>
                                <span class="badge @(bulletin.IsVisible ? "bg-success" : "bg-secondary")">
                                    @(bulletin.IsVisible ? "공개" : "비공개")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/Admin/Bulletins/Edit/@bulletin.Id" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary" onclick="toggleVisibility(@bulletin.Id)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" onclick="deleteBulletin(@bulletin.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 페이징 -->
    @if (Model.Pagination.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.Pagination.HasPrevious ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.Pagination.CurrentPage - 1)">이전</a>
                </li>
                @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.Pagination.HasNext ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.Pagination.CurrentPage + 1)">다음</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        function toggleVisibility(id) {
            if (!confirm('표시 여부를 변경하시겠습니까?')) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch(`/Admin/Bulletins/ToggleVisibility/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            });
        }

        function deleteBulletin(id) {
            if (!confirm('정말 삭제하시겠습니까?')) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch(`/Admin/Bulletins/Delete/${id}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            });
        }
    </script>
    @Html.AntiForgeryToken()
}
