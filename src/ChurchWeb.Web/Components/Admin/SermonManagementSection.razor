@using ChurchWeb.Core.Entities.Sermons
@using ChurchWeb.Web.Components.Shared
@inject ISermonAdminService SermonService
@inject ILogger<SermonManagementSection> Logger

<section class="page show">
    <div class="page-head">
        <h2 class="serif">설교 말씀</h2>
        <p>설교 영상을 등록하고 관리합니다.</p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null">×</button>
        </div>
    }

    <div class="card">
        <div class="row" style="align-items:center;margin-bottom:1rem">
            <h3 style="margin:0">설교 목록 (@totalCount 개)</h3>
            <div class="spacer"></div>
            <button type="button" class="btn primary" @onclick="ShowCreateForm">
                + 새 설교 등록
            </button>
        </div>

        @* 검색/필터 *@
        <div class="grid g3" style="margin-bottom:1.5rem">
            <div class="field">
                <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="제목, 설교자, 본문 검색" />
            </div>
            <div class="field">
                <select @bind="filterCategory">
                    <option value="">전체 분류</option>
                    <option value="sunday">주일설교</option>
                    <option value="special">특별설교</option>
                </select>
            </div>
            <div class="field">
                <button type="button" class="btn primary" style="width:100%" @onclick="LoadSermons">검색</button>
            </div>
        </div>

        @if (sermons.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">순서</th>
                            <th>제목</th>
                            <th style="width: 120px;">본문</th>
                            <th style="width: 100px;">설교자</th>
                            <th style="width: 110px;">설교일</th>
                            <th style="width: 90px;">분류</th>
                            <th style="width: 80px;">표시</th>
                            <th style="width: 150px;" class="text-center">관리</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sermon in sermons)
                        {
                            <tr>
                                <td style="text-align:center">
                                    <span class="tag">@sermon.SortOrder</span>
                                </td>
                                <td>
                                    <b>@sermon.Title</b>
                                    @if (!string.IsNullOrEmpty(sermon.YoutubeUrl))
                                    {
                                        <span style="color:var(--red);margin-left:0.25rem">▶</span>
                                    }
                                </td>
                                <td><small style="color:#999">@sermon.Verse</small></td>
                                <td>@sermon.Preacher</td>
                                <td>@sermon.PreachedOn.ToString("yyyy.MM.dd")</td>
                                <td>
                                    <span class="tag" style="@(sermon.Category == "sunday" ? "background:var(--gold);color:#fff" : "background:#17a2b8;color:#fff")">
                                        @(sermon.Category == "sunday" ? "주일" : "특별")
                                    </span>
                                </td>
                                <td>
                                    <button type="button" class="tag @(sermon.IsVisible ? "g" : "")" @onclick="() => ToggleVisibility(sermon.Id)">
                                        @(sermon.IsVisible ? "표시" : "숨김")
                                    </button>
                                </td>
                                <td style="text-align:center">
                                    <div class="rowacts">
                                        <button class="icon-btn" @onclick="() => ShowEditForm(sermon.Id)">
                                            <Icon Name="pencil" />
                                        </button>
                                        <button class="icon-btn danger" @onclick="() => DeleteSermon(sermon.Id)">
                                            <Icon Name="trash" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* 페이지네이션 *@
            @if (totalPages > 1)
            {
                <div style="display:flex;justify-content:center;gap:0.5rem;margin-top:1rem">
                    <button type="button" class="btn ghost" @onclick="PreviousPage" disabled="@(currentPage <= 1)">이전</button>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNum = i;
                        <button type="button" class="btn @(currentPage == pageNum ? "primary" : "ghost")" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button type="button" class="btn ghost" @onclick="NextPage" disabled="@(currentPage >= totalPages)">다음</button>
                </div>
            }
        }
        else
        {
            <div style="text-align:center;padding:3rem 0">
                <p style="color:#999">등록된 설교가 없습니다.</p>
                <button type="button" class="btn primary" @onclick="ShowCreateForm">첫 설교 등록하기</button>
            </div>
        }
    </div>

    @* 설교 추가/수정 폼 *@
    @if (showForm)
    {
        <div class="card mt">
            <h3>@(editingSermonId == 0 ? "새 설교 등록" : "설교 수정")</h3>

            <EditForm Model="@formModel" OnValidSubmit="SaveSermon">
                <DataAnnotationsValidator />

                <div class="grid g2">
                    <div class="field">
                        <label>제목</label>
                        <InputText @bind-value="formModel.Title" type="text" placeholder="설교 제목" />
                        <ValidationMessage For="@(() => formModel.Title)" class="text-danger" />
                    </div>

                    <div class="field">
                        <label>본문</label>
                        <InputText @bind-value="formModel.Verse" type="text" placeholder="요한복음 3:16" />
                        <ValidationMessage For="@(() => formModel.Verse)" class="text-danger" />
                    </div>

                    <div class="field">
                        <label>설교자</label>
                        <InputText @bind-value="formModel.Preacher" type="text" placeholder="담임목사" />
                        <ValidationMessage For="@(() => formModel.Preacher)" class="text-danger" />
                    </div>

                    <div class="field">
                        <label>설교일</label>
                        <InputDate @bind-value="formModel.PreachedOn" />
                        <ValidationMessage For="@(() => formModel.PreachedOn)" class="text-danger" />
                    </div>

                    <div class="field">
                        <label>분류</label>
                        <InputSelect @bind-value="formModel.Category">
                            <option value="sunday">주일설교</option>
                            <option value="special">특별설교</option>
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label>정렬 순서</label>
                        <InputNumber @bind-value="formModel.SortOrder" type="number" />
                    </div>
                </div>

                <div class="field">
                    <label>YouTube URL</label>
                    <InputText @bind-value="formModel.YoutubeUrl" type="url" placeholder="https://youtu.be/xxxxxxxxxxx" />
                </div>

                <div class="field">
                    <label>요약</label>
                    <InputTextArea @bind-value="formModel.Summary" rows="3" placeholder="설교 요약 (선택사항)" />
                </div>

                <div class="field">
                    <label style="display:flex;align-items:center;gap:0.5rem">
                        <InputCheckbox @bind-value="formModel.IsVisible" />
                        설교 표시
                    </label>
                </div>

                <div class="flex-end" style="margin-top:1.5rem">
                    <button type="button" class="btn ghost" @onclick="CancelForm"><Icon Name="x" /> 취소</button>
                    <button type="submit" class="btn primary"><Icon Name="save" /> 저장하기</button>
                </div>
            </EditForm>
        </div>
    }
</section>

@code {
    private List<SermonItemViewModel> sermons = new();
    private SermonFormViewModel formModel = new();
    private string? successMessage;
    private string? errorMessage;
    private bool showForm = false;
    private int editingSermonId = 0;

    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount = 0;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);

    private string? searchTerm;
    private string? filterCategory;

    protected override async Task OnInitializedAsync()
    {
        await LoadSermons();
    }

    private async Task LoadSermons()
    {
        try
        {
            var (items, count) = await SermonService.GetPagedSermonsAsync(
                currentPage, pageSize, searchTerm, filterCategory);

            totalCount = count;
            sermons = items.Select(s => new SermonItemViewModel
            {
                Id = s.Id,
                Title = s.Title,
                Verse = s.Verse,
                Preacher = s.Preacher,
                PreachedOn = s.PreachedOn,
                Category = s.Category,
                IsVisible = s.IsVisible,
                SortOrder = s.SortOrder,
                YoutubeUrl = s.YoutubeUrl
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sermons");
            errorMessage = "설교 목록을 불러오는 중 오류가 발생했습니다.";
        }
    }

    private void ShowCreateForm()
    {
        editingSermonId = 0;
        formModel = new SermonFormViewModel
        {
            PreachedOn = DateTime.Now,
            Category = "sunday",
            IsVisible = true,
            SortOrder = sermons.Any() ? sermons.Max(s => s.SortOrder) + 1 : 1
        };
        showForm = true;
        successMessage = null;
        errorMessage = null;
    }

    private async Task ShowEditForm(int id)
    {
        try
        {
            var sermon = await SermonService.GetSermonByIdAsync(id);
            if (sermon == null)
            {
                errorMessage = "설교를 찾을 수 없습니다.";
                return;
            }

            editingSermonId = id;
            formModel = new SermonFormViewModel
            {
                Id = sermon.Id,
                Title = sermon.Title,
                Verse = sermon.Verse,
                Preacher = sermon.Preacher,
                PreachedOn = sermon.PreachedOn,
                Category = sermon.Category,
                YoutubeUrl = sermon.YoutubeUrl,
                Summary = sermon.Summary,
                IsVisible = sermon.IsVisible,
                SortOrder = sermon.SortOrder
            };
            showForm = true;
            successMessage = null;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sermon for edit");
            errorMessage = "설교를 불러오는 중 오류가 발생했습니다.";
        }
    }

    private async Task SaveSermon()
    {
        try
        {
            if (editingSermonId == 0)
            {
                var sermon = new Sermon
                {
                    Title = formModel.Title,
                    Verse = formModel.Verse,
                    Preacher = formModel.Preacher,
                    PreachedOn = formModel.PreachedOn,
                    Category = formModel.Category,
                    YoutubeUrl = formModel.YoutubeUrl,
                    Summary = formModel.Summary,
                    IsVisible = formModel.IsVisible,
                    SortOrder = formModel.SortOrder,
                    VideoDescription = string.Empty,
                    Duration = string.Empty,
                    ThumbnailUrl = string.Empty
                };

                await SermonService.CreateSermonAsync(sermon);
                successMessage = "설교가 성공적으로 등록되었습니다.";
            }
            else
            {
                var sermon = await SermonService.GetSermonByIdAsync(editingSermonId);
                if (sermon == null)
                {
                    errorMessage = "설교를 찾을 수 없습니다.";
                    return;
                }

                sermon.Title = formModel.Title;
                sermon.Verse = formModel.Verse;
                sermon.Preacher = formModel.Preacher;
                sermon.PreachedOn = formModel.PreachedOn;
                sermon.Category = formModel.Category;
                sermon.YoutubeUrl = formModel.YoutubeUrl;
                sermon.Summary = formModel.Summary;
                sermon.IsVisible = formModel.IsVisible;
                sermon.SortOrder = formModel.SortOrder;

                await SermonService.UpdateSermonAsync(sermon);
                successMessage = "설교가 성공적으로 수정되었습니다.";
            }

            showForm = false;
            await LoadSermons();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving sermon");
            errorMessage = "설교 저장 중 오류가 발생했습니다.";
        }
    }

    private void CancelForm()
    {
        showForm = false;
        formModel = new SermonFormViewModel();
        editingSermonId = 0;
    }

    private async Task ToggleVisibility(int id)
    {
        try
        {
            var result = await SermonService.ToggleVisibilityAsync(id);
            if (result)
            {
                await LoadSermons();
                successMessage = "표시 여부가 변경되었습니다.";
            }
            else
            {
                errorMessage = "설교를 찾을 수 없습니다.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling visibility");
            errorMessage = "표시 여부 변경 중 오류가 발생했습니다.";
        }
    }

    private async Task DeleteSermon(int id)
    {
        try
        {
            var result = await SermonService.DeleteSermonAsync(id);
            if (result)
            {
                await LoadSermons();
                successMessage = "설교가 삭제되었습니다.";
            }
            else
            {
                errorMessage = "설교 삭제에 실패했습니다.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting sermon");
            errorMessage = "설교 삭제 중 오류가 발생했습니다.";
        }
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadSermons();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadSermons();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadSermons();
        }
    }
}
