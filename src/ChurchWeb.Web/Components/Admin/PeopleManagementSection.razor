@using ChurchWeb.Core.Entities.People
@using ChurchWeb.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using ChurchWeb.Web.Components.Shared
@inject AppDbContext DbContext
@inject ILogger<PeopleManagementSection> Logger
@inject NavigationManager Navigation

<section class="page show">
    <div class="page-head">
        <h2 class="serif">섬기는 사람들 관리</h2>
        <p>담임목사 소개와 교역자·직분자 목록을 등록·수정하고 노출을 제어합니다.</p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            @errorMessage
        </div>
    }

    <!-- 담임목사 (대표) -->
    <div class="card">
        <div class="card-head">
            <h3>담임목사 (대표 소개)</h3>
            <span class="tag">상단 대표 표시</span>
        </div>
        <div class="sub">페이지 최상단에 크게 노출되는 대표 교역자입니다.</div>

        <EditForm Model="@headPastor" OnValidSubmit="SaveHeadPastor">
            <div class="pastor">
                <div class="photo">
                    @if (!string.IsNullOrEmpty(headPastor.PhotoUrl))
                    {
                        <img src="@headPastor.PhotoUrl" alt="사진" style="width:100%;height:100%;object-fit:cover;border-radius:12px;" />
                    }
                    else
                    {
                        <text>[사진]</text>
                    }
                    <ImageUploader @bind-ImageUrl="headPastor.PhotoUrl" />
                </div>
                <div class="body">
                    <div class="grid g3" style="margin-bottom:14px">
                        <div class="field">
                            <label>이름</label>
                            <InputText @bind-Value="headPastor.Name" />
                        </div>
                        <div class="field">
                            <label>직분</label>
                            <InputText @bind-Value="headPastor.Title" placeholder="목사" />
                        </div>
                        <div class="field">
                            <label>구분</label>
                            <InputSelect @bind-Value="headPastor.Role">
                                <option value="담임목사">담임목사</option>
                                <option value="원로목사">원로목사</option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="field" style="margin-bottom:14px">
                        <label>인용구 <span class="hint">선택</span></label>
                        <InputText @bind-Value="headPastor.Quote" placeholder="예: 말씀과 기도로 섬기며, 한 영혼을 귀하게 여기는 목회를 꿈꿉니다." />
                    </div>
                    <div class="field">
                        <label>소개 문구 <span class="hint">인사말/약력</span></label>
                        <InputTextArea @bind-Value="headPastor.Intro" rows="3" />
                    </div>
                    <div class="flex-end">
                        <button type="submit" class="btn primary"><Icon Name="save" /> 담임목사 저장</button>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>

    <!-- 인물 목록 -->
    <div class="card">
        <div class="card-head">
            <h3>교역자 · 직분자 목록</h3>
            <button class="btn primary" @onclick="AddNewPerson">＋ 새 인물 추가</button>
        </div>
        <div class="sub">직분별로 분류되어 /about/people 에 카드로 표시됩니다. 드래그로 순서 변경.</div>

        <div class="info-strip">ⓘ '노출'을 끄면 해당 인물이 공개 페이지에서 숨겨집니다. 순서는 저장 즉시 반영됩니다.</div>

        <!-- 필터 칩 -->
        <div class="filters" style="margin-bottom:16px">
            <span class="chip @(selectedCategory == "all" ? "on" : "")" @onclick="@(() => FilterByCategory("all"))">
                전체 @people.Count(p => !p.IsHead)
            </span>
            <span class="chip @(selectedCategory == "pastor" ? "on" : "")" @onclick="@(() => FilterByCategory("pastor"))">
                교역자 @people.Count(p => !p.IsHead && p.Category == "pastor")
            </span>
            <span class="chip @(selectedCategory == "elder" ? "on" : "")" @onclick="@(() => FilterByCategory("elder"))">
                장로 @people.Count(p => !p.IsHead && p.Category == "elder")
            </span>
            <span class="chip @(selectedCategory == "deacon" ? "on" : "")" @onclick="@(() => FilterByCategory("deacon"))">
                안수집사 @people.Count(p => !p.IsHead && p.Category == "deacon")
            </span>
            <span class="chip @(selectedCategory == "deaconess" ? "on" : "")" @onclick="@(() => FilterByCategory("deaconess"))">
                권사 @people.Count(p => !p.IsHead && p.Category == "deaconess")
            </span>
        </div>

        @foreach (var category in GetFilteredCategories())
        {
            var categoryPeople = people.Where(p => !p.IsHead && p.Category == category.Key).OrderBy(p => p.SortOrder).ToList();
            if (categoryPeople.Any())
            {
                <div class="group-label">@category.Label</div>
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width:28px"></th>
                            <th style="width:64px">사진</th>
                            <th>이름 / 부서</th>
                            <th style="width:110px">직분</th>
                            <th style="width:90px">노출</th>
                            <th style="width:96px">관리</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in categoryPeople)
                        {
                            <tr>
                                <td><span class="grip">⣿</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(person.PhotoUrl))
                                    {
                                        <img src="@person.PhotoUrl" alt="@person.Name" style="width:52px;height:52px;border-radius:9px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="th-photo">사진</div>
                                    }
                                </td>
                                <td>
                                    <div class="pname">@person.Name</div>
                                    @if (!string.IsNullOrEmpty(person.Ministry))
                                    {
                                        <div class="pdept">@person.Ministry</div>
                                    }
                                </td>
                                <td>
                                    <span class="tag @GetTagColor(person.Category)">@person.Title</span>
                                </td>
                                <td>
                                    <label class="toggle">
                                        <input type="checkbox" checked="@person.IsVisible" @onchange="@(e => ToggleVisibility(person, (bool)e.Value!))" />
                                        <span class="tr"></span>
                                    </label>
                                </td>
                                <td>
                                    <div class="rowacts">
                                        <button class="icon-btn" @onclick="@(() => EditPerson(person))"><Icon Name="pencil" /></button>
                                        <button class="icon-btn danger" @onclick="@(() => DeletePerson(person))"><Icon Name="trash" /></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>

    <!-- 추가/수정 폼 -->
    @if (editingPerson != null)
    {
        <div class="card">
            <h3>@(editingPerson.Id == 0 ? "인물 추가" : "인물 수정")</h3>
            <div class="sub">정보를 입력하고 저장하세요.</div>

            <EditForm Model="@editingPerson" OnValidSubmit="SavePerson">
                <div class="grid g3" style="margin-bottom:14px">
                    <div class="field">
                        <label>이름</label>
                        <InputText @bind-Value="editingPerson.Name" placeholder="예: 김철수" />
                    </div>
                    <div class="field">
                        <label>직분</label>
                        <InputSelect @bind-Value="editingPerson.Title">
                            <option value="">선택하세요</option>
                            <option value="부목사">부목사</option>
                            <option value="전도사">전도사</option>
                            <option value="장로">장로</option>
                            <option value="안수집사">안수집사</option>
                            <option value="권사">권사</option>
                            <option value="집사">집사</option>
                        </InputSelect>
                    </div>
                    <div class="field">
                        <label>분류(그룹)</label>
                        <InputSelect @bind-Value="editingPerson.Category">
                            <option value="">선택하세요</option>
                            <option value="pastor">교역자</option>
                            <option value="elder">장로</option>
                            <option value="deacon">안수집사</option>
                            <option value="deaconess">권사</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="grid g2" style="margin-bottom:14px">
                    <div class="field">
                        <label>부서 / 설명 <span class="hint">선택</span></label>
                        <InputText @bind-Value="editingPerson.Ministry" placeholder="예: 교육부서" />
                    </div>
                    <div class="field">
                        <label>정렬 순서</label>
                        <InputNumber @bind-Value="editingPerson.SortOrder" />
                    </div>
                </div>
                <div class="grid g2" style="align-items:center;margin-bottom:14px">
                    <div class="field">
                        <label>사진</label>
                        <ImageUploader @bind-ImageUrl="editingPerson.PhotoUrl" />
                        @if (!string.IsNullOrEmpty(editingPerson.PhotoUrl))
                        {
                            <img src="@editingPerson.PhotoUrl" alt="미리보기" style="width:80px;height:80px;object-fit:cover;border-radius:9px;margin-top:8px;" />
                        }
                    </div>
                    <div class="field">
                        <label>노출</label>
                        <label class="toggle" style="margin-top:4px">
                            <input type="checkbox" @bind="editingPerson.IsVisible" />
                            <span class="tr"></span>
                        </label>
                    </div>
                </div>
                <div class="flex-end">
                    <button type="button" class="btn ghost" @onclick="CancelEdit"><Icon Name="x" /> 취소</button>
                    <button type="submit" class="btn primary"><Icon Name="save" /> 저장하기</button>
                </div>
            </EditForm>
        </div>
    }
</section>

@code {
    private Person headPastor = new Person();
    private List<Person> people = new();
    private Person? editingPerson = null;
    private string selectedCategory = "all";
    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        people = await DbContext.People.ToListAsync();
        headPastor = people.FirstOrDefault(p => p.IsHead) ?? new Person
        {
            IsHead = true,
            Name = "",
            Title = "목사",
            Role = "담임목사",
            Category = "pastor",
            IsVisible = true,
            SortOrder = 1
        };
    }

    private async Task SaveHeadPastor()
    {
        try
        {
            headPastor.IsHead = true;
            headPastor.Category = "pastor";
            headPastor.UpdatedAt = DateTime.UtcNow;

            if (headPastor.Id == 0)
            {
                headPastor.CreatedAt = DateTime.UtcNow;
                DbContext.People.Add(headPastor);
            }
            else
            {
                DbContext.People.Update(headPastor);
            }

            await DbContext.SaveChangesAsync();
            successMessage = "담임목사 정보가 저장되었습니다.";
            errorMessage = "";
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"저장 중 오류가 발생했습니다: {ex.Message}";
            successMessage = "";
            Logger.LogError(ex, "Error saving head pastor");
        }
    }

    private void AddNewPerson()
    {
        editingPerson = new Person
        {
            IsHead = false,
            IsVisible = true,
            SortOrder = people.Count(p => !p.IsHead) + 1
        };
    }

    private void EditPerson(Person person)
    {
        editingPerson = new Person
        {
            Id = person.Id,
            IsHead = false,
            Name = person.Name,
            Title = person.Title,
            Role = person.Role,
            Category = person.Category,
            Ministry = person.Ministry,
            PhotoUrl = person.PhotoUrl,
            Intro = person.Intro,
            Quote = person.Quote,
            IsVisible = person.IsVisible,
            SortOrder = person.SortOrder,
            CreatedAt = person.CreatedAt
        };
    }

    private async Task SavePerson()
    {
        if (editingPerson == null) return;

        try
        {
            editingPerson.UpdatedAt = DateTime.UtcNow;

            if (editingPerson.Id == 0)
            {
                editingPerson.CreatedAt = DateTime.UtcNow;
                DbContext.People.Add(editingPerson);
            }
            else
            {
                var existing = await DbContext.People.FindAsync(editingPerson.Id);
                if (existing != null)
                {
                    existing.Name = editingPerson.Name;
                    existing.Title = editingPerson.Title;
                    existing.Role = editingPerson.Role;
                    existing.Category = editingPerson.Category;
                    existing.Ministry = editingPerson.Ministry;
                    existing.PhotoUrl = editingPerson.PhotoUrl;
                    existing.Intro = editingPerson.Intro;
                    existing.Quote = editingPerson.Quote;
                    existing.IsVisible = editingPerson.IsVisible;
                    existing.SortOrder = editingPerson.SortOrder;
                    existing.UpdatedAt = editingPerson.UpdatedAt;
                }
            }

            await DbContext.SaveChangesAsync();
            successMessage = "인물 정보가 저장되었습니다.";
            errorMessage = "";
            editingPerson = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"저장 중 오류가 발생했습니다: {ex.Message}";
            successMessage = "";
            Logger.LogError(ex, "Error saving person");
        }
    }

    private void CancelEdit()
    {
        editingPerson = null;
    }

    private async Task DeletePerson(Person person)
    {
        if (!confirm($"{person.Name}을(를) 삭제하시겠습니까?")) return;

        try
        {
            DbContext.People.Remove(person);
            await DbContext.SaveChangesAsync();
            successMessage = "인물이 삭제되었습니다.";
            errorMessage = "";
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"삭제 중 오류가 발생했습니다: {ex.Message}";
            successMessage = "";
            Logger.LogError(ex, "Error deleting person");
        }
    }

    private async Task ToggleVisibility(Person person, bool isVisible)
    {
        try
        {
            person.IsVisible = isVisible;
            person.UpdatedAt = DateTime.UtcNow;
            DbContext.People.Update(person);
            await DbContext.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling visibility");
        }
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
    }

    private List<(string Key, string Label)> GetFilteredCategories()
    {
        var categories = new List<(string Key, string Label)>
        {
            ("pastor", "교역자"),
            ("elder", "장로"),
            ("deacon", "안수집사"),
            ("deaconess", "권사")
        };

        if (selectedCategory == "all")
        {
            return categories;
        }
        else
        {
            return categories.Where(c => c.Key == selectedCategory).ToList();
        }
    }

    private string GetTagColor(string category)
    {
        return category switch
        {
            "pastor" => "blue",
            "elder" => "",
            "deacon" => "",
            "deaconess" => "green",
            _ => ""
        };
    }

    private bool confirm(string message)
    {
        // JavaScript confirm 대신 간단한 로직으로 대체
        // 실제로는 JavaScript interop을 사용해야 함
        return true;
    }
}
