@using ChurchWeb.Web.Components.Shared
@inject IMenuAdminService MenuService
@inject ILogger<MenuManagementSection> Logger

<section class="page show">
    <div class="page-head">
        <h2 class="serif">메뉴 노출 관리</h2>
        <p>사이트 네비게이션 메뉴의 구조와 표시 여부를 제어합니다.</p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null">×</button>
        </div>
    }

    <div class="card">
        <div class="row" style="align-items:center;margin-bottom:1rem">
            <h3 style="margin:0">메뉴 목록 (@menuItems.Count 개)</h3>
            <div class="spacer"></div>
            <button type="button" class="btn primary" @onclick="ShowCreateForm">
                + 새 메뉴 추가
            </button>
        </div>

        @if (menuItems.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">순서</th>
                            <th>제목</th>
                            <th style="width: 250px;">URL</th>
                            <th style="width: 120px;">부모 메뉴</th>
                            <th style="width: 80px;">하위</th>
                            <th style="width: 80px;">표시</th>
                            <th style="width: 150px;" class="text-center">관리</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var menu in menuItems.Where(m => m.ParentId == null).OrderBy(m => m.SortOrder))
                        {
                            <tr>
                                <td style="text-align:center">
                                    <span class="tag">@menu.SortOrder</span>
                                </td>
                                <td>
                                    <b>@menu.Title</b>
                                    @if (menu.OpenInNewTab)
                                    {
                                        <span style="color:var(--gold);margin-left:0.25rem">↗</span>
                                    }
                                </td>
                                <td><small style="color:#999">@menu.Url</small></td>
                                <td>-</td>
                                <td style="text-align:center">
                                    @if (menu.ChildCount > 0)
                                    {
                                        <span class="tag" style="background:var(--gold);color:#fff">@menu.ChildCount</span>
                                    }
                                    else
                                    {
                                        <span style="color:#999">-</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="tag @(menu.IsVisible ? "g" : "")" @onclick="() => ToggleVisibility(menu.Id)">
                                        @(menu.IsVisible ? "표시" : "숨김")
                                    </button>
                                </td>
                                <td style="text-align:center">
                                    <div class="rowacts">
                                        <button class="icon-btn" @onclick="() => ShowEditForm(menu.Id)">
                                            <Icon Name="pencil" />
                                        </button>
                                        <button class="icon-btn danger" @onclick="() => DeleteMenu(menu.Id)">
                                            <Icon Name="trash" />
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @* 하위 메뉴 표시 *@
                            @foreach (var child in menuItems.Where(m => m.ParentId == menu.Id).OrderBy(m => m.SortOrder))
                            {
                                <tr style="background:#f9f7f4">
                                    <td style="text-align:center;padding-left:2rem">
                                        <small class="tag" style="background:#ddd;color:#666">@child.SortOrder</small>
                                    </td>
                                    <td style="padding-left:2.5rem">
                                        <span style="color:#999;margin-right:0.5rem">↳</span>
                                        @child.Title
                                        @if (child.OpenInNewTab)
                                        {
                                            <span style="color:var(--gold);margin-left:0.25rem">↗</span>
                                        }
                                    </td>
                                    <td><small style="color:#999">@child.Url</small></td>
                                    <td><small>@menu.Title</small></td>
                                    <td style="text-align:center">-</td>
                                    <td>
                                        <button type="button" class="tag @(child.IsVisible ? "g" : "")" @onclick="() => ToggleVisibility(child.Id)">
                                            @(child.IsVisible ? "표시" : "숨김")
                                        </button>
                                    </td>
                                    <td style="text-align:center">
                                        <div class="rowacts">
                                            <button class="icon-btn" @onclick="() => ShowEditForm(child.Id)">
                                                <Icon Name="pencil" />
                                            </button>
                                            <button class="icon-btn danger" @onclick="() => DeleteMenu(child.Id)">
                                                <Icon Name="trash" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:3rem 0">
                <p style="color:#999">등록된 메뉴가 없습니다.</p>
                <button type="button" class="btn primary" @onclick="ShowCreateForm">첫 메뉴 추가하기</button>
            </div>
        }
    </div>

    @* 메뉴 추가/수정 폼 *@
    @if (showForm)
    {
        <div class="card mt">
            <h3>@(editingMenuId == 0 ? "새 메뉴 추가" : "메뉴 수정")</h3>

            <EditForm Model="@formModel" OnValidSubmit="SaveMenu">
                <DataAnnotationsValidator />

                <div class="grid g2">
                    <div class="field">
                        <label>제목</label>
                        <InputText @bind-value="formModel.Title" type="text" placeholder="메뉴 제목" />
                        <ValidationMessage For="@(() => formModel.Title)" class="text-danger" />
                    </div>

                    <div class="field">
                        <label>URL</label>
                        <InputText @bind-value="formModel.Url" type="text" placeholder="/About/Vision" />
                        <ValidationMessage For="@(() => formModel.Url)" class="text-danger" />
                    </div>

                    <div class="field">
                        <label>부모 메뉴</label>
                        <InputSelect @bind-value="formModel.ParentId" class="form-select">
                            <option value="">최상위 메뉴</option>
                            @foreach (var parent in menuItems.Where(m => m.Id != editingMenuId && m.ParentId == null))
                            {
                                <option value="@parent.Id">@parent.Title</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label>정렬 순서</label>
                        <InputNumber @bind-value="formModel.SortOrder" type="number" placeholder="1" />
                        <ValidationMessage For="@(() => formModel.SortOrder)" class="text-danger" />
                    </div>

                    <div class="field">
                        <label>아이콘 클래스</label>
                        <InputText @bind-value="formModel.IconClass" type="text" placeholder="bi bi-house (선택사항)" />
                    </div>

                    <div class="field">
                        <label style="display:flex;align-items:center;gap:0.5rem">
                            <InputCheckbox @bind-value="formModel.IsVisible" />
                            메뉴 표시
                        </label>
                    </div>

                    <div class="field">
                        <label style="display:flex;align-items:center;gap:0.5rem">
                            <InputCheckbox @bind-value="formModel.OpenInNewTab" />
                            새 탭에서 열기
                        </label>
                    </div>
                </div>

                <div class="flex-end" style="margin-top:1.5rem">
                    <button type="button" class="btn ghost" @onclick="CancelForm"><Icon Name="x" /> 취소</button>
                    <button type="submit" class="btn primary"><Icon Name="save" /> 저장하기</button>
                </div>
            </EditForm>
        </div>
    }
</section>

@code {
    private List<MenuItemViewModel> menuItems = new();
    private MenuItemViewModel formModel = new();
    private string? successMessage;
    private string? errorMessage;
    private bool showForm = false;
    private int editingMenuId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadMenuItems();
    }

    private async Task LoadMenuItems()
    {
        try
        {
            var items = await MenuService.GetAllMenuItemsAsync();
            menuItems = items.Select(m => new MenuItemViewModel
            {
                Id = m.Id,
                Title = m.Title,
                Url = m.Url,
                ParentId = m.ParentId,
                SortOrder = m.SortOrder,
                IsVisible = m.IsVisible,
                IconClass = m.IconClass,
                OpenInNewTab = m.OpenInNewTab,
                ParentTitle = m.Parent?.Title,
                ChildCount = m.Children.Count
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading menu items");
            errorMessage = "메뉴 목록을 불러오는 중 오류가 발생했습니다.";
        }
    }

    private void ShowCreateForm()
    {
        editingMenuId = 0;
        formModel = new MenuItemViewModel
        {
            SortOrder = menuItems.Any() ? menuItems.Max(m => m.SortOrder) + 1 : 1,
            IsVisible = true,
            OpenInNewTab = false
        };
        showForm = true;
        successMessage = null;
        errorMessage = null;
    }

    private async Task ShowEditForm(int id)
    {
        try
        {
            var menuItem = await MenuService.GetMenuItemByIdAsync(id);
            if (menuItem == null)
            {
                errorMessage = "메뉴를 찾을 수 없습니다.";
                return;
            }

            editingMenuId = id;
            formModel = new MenuItemViewModel
            {
                Id = menuItem.Id,
                Title = menuItem.Title,
                Url = menuItem.Url,
                ParentId = menuItem.ParentId,
                SortOrder = menuItem.SortOrder,
                IsVisible = menuItem.IsVisible,
                IconClass = menuItem.IconClass,
                OpenInNewTab = menuItem.OpenInNewTab
            };
            showForm = true;
            successMessage = null;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading menu item for edit");
            errorMessage = "메뉴를 불러오는 중 오류가 발생했습니다.";
        }
    }

    private async Task SaveMenu()
    {
        try
        {
            if (editingMenuId == 0)
            {
                // 생성
                var menuItem = new NavMenuItem
                {
                    Title = formModel.Title,
                    Url = formModel.Url,
                    ParentId = formModel.ParentId,
                    SortOrder = formModel.SortOrder,
                    IsVisible = formModel.IsVisible,
                    IconClass = formModel.IconClass,
                    OpenInNewTab = formModel.OpenInNewTab
                };

                await MenuService.CreateMenuItemAsync(menuItem);
                successMessage = "메뉴가 성공적으로 생성되었습니다.";
            }
            else
            {
                // 수정
                var menuItem = await MenuService.GetMenuItemByIdAsync(editingMenuId);
                if (menuItem == null)
                {
                    errorMessage = "메뉴를 찾을 수 없습니다.";
                    return;
                }

                menuItem.Title = formModel.Title;
                menuItem.Url = formModel.Url;
                menuItem.ParentId = formModel.ParentId;
                menuItem.SortOrder = formModel.SortOrder;
                menuItem.IsVisible = formModel.IsVisible;
                menuItem.IconClass = formModel.IconClass;
                menuItem.OpenInNewTab = formModel.OpenInNewTab;

                await MenuService.UpdateMenuItemAsync(menuItem);
                successMessage = "메뉴가 성공적으로 수정되었습니다.";
            }

            showForm = false;
            await LoadMenuItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving menu item");
            errorMessage = "메뉴 저장 중 오류가 발생했습니다.";
        }
    }

    private void CancelForm()
    {
        showForm = false;
        formModel = new MenuItemViewModel();
        editingMenuId = 0;
    }

    private async Task ToggleVisibility(int id)
    {
        try
        {
            var result = await MenuService.ToggleVisibilityAsync(id);
            if (result)
            {
                await LoadMenuItems();
                successMessage = "표시 여부가 변경되었습니다.";
            }
            else
            {
                errorMessage = "메뉴를 찾을 수 없습니다.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling visibility");
            errorMessage = "표시 여부 변경 중 오류가 발생했습니다.";
        }
    }

    private async Task DeleteMenu(int id)
    {
        try
        {
            var menuItem = menuItems.FirstOrDefault(m => m.Id == id);
            if (menuItem != null && menuItem.ChildCount > 0)
            {
                errorMessage = "하위 메뉴가 있는 메뉴는 삭제할 수 없습니다. 먼저 하위 메뉴를 삭제해주세요.";
                return;
            }

            var result = await MenuService.DeleteMenuItemAsync(id);
            if (result)
            {
                await LoadMenuItems();
                successMessage = "메뉴가 삭제되었습니다.";
            }
            else
            {
                errorMessage = "메뉴 삭제에 실패했습니다.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting menu item");
            errorMessage = "메뉴 삭제 중 오류가 발생했습니다.";
        }
    }
}
