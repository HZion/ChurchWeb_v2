@using ChurchWeb.Web.Components.Shared
@using ChurchWeb.Web.Models.Admin
@inject IHomeSectionAdminService HomeSectionService
@inject ILogger<HomeSectionManagement> Logger

<section class="page show">
    <div class="page-head">
        <h2 class="serif">홈 화면 섹션 노출 관리</h2>
        <p>홈 화면에 표시되는 섹션의 노출 여부를 토글로 즉시 제어합니다. 끄면 사이트 홈 화면에서 사라집니다.</p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null">×</button>
        </div>
    }

    <div class="info-strip">ⓘ 순서는 드래그로 변경할 수 있으며, 변경 사항은 저장 즉시 사이트에 반영됩니다.</div>

    <div class="card">
        <h3>홈 화면 섹션 목록</h3>
        <div class="sub" style="margin-bottom:18px">
            노출 @homeSections.Count(s => s.IsVisible)개 · 숨김은 회색으로 표시됩니다.
        </div>

        @if (homeSections.Any())
        {
            @foreach (var section in homeSections.OrderBy(s => s.SortOrder))
            {
                <div class="menu-item @(!section.IsVisible ? "off" : "")" style="margin-bottom:10px">
                    <span class="grip">⣿</span>
                    <div class="mi-body">
                        <b>@GetSectionDisplayName(section.Key)</b>
                        <span>@section.Key @(!section.IsVisible ? "· 현재 숨김" : "")</span>
                    </div>
                    <label class="toggle">
                        <input type="checkbox" checked="@section.IsVisible" @onchange="() => ToggleVisibility(section.Id)">
                        <span class="track"></span>
                    </label>
                </div>
            }

            <div class="flex-end mt">
                <button type="button" class="btn primary" @onclick="SaveChanges">변경 사항 저장</button>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:3rem 0">
                <p style="color:#999">등록된 섹션이 없습니다.</p>
            </div>
        }
    </div>
</section>

@code {
    private List<HomeSectionViewModel> homeSections = new();
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadHomeSections();
    }

    private async Task LoadHomeSections()
    {
        try
        {
            var sections = await HomeSectionService.GetAllHomeSectionsAsync();
            homeSections = sections.Select(s => new HomeSectionViewModel
            {
                Id = s.Id,
                Key = s.Key,
                Title = s.Title,
                IsVisible = s.IsVisible,
                SortOrder = s.SortOrder
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading home sections");
            errorMessage = "홈 섹션 목록을 불러오는 중 오류가 발생했습니다.";
        }
    }

    private async Task ToggleVisibility(int id)
    {
        try
        {
            var result = await HomeSectionService.ToggleVisibilityAsync(id);
            if (result)
            {
                await LoadHomeSections();
                successMessage = "표시 여부가 변경되었습니다.";
            }
            else
            {
                errorMessage = "섹션을 찾을 수 없습니다.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling visibility");
            errorMessage = "표시 여부 변경 중 오류가 발생했습니다.";
        }
    }

    private async Task SaveChanges()
    {
        try
        {
            successMessage = "변경 사항이 저장되었습니다.";
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving changes");
            errorMessage = "저장 중 오류가 발생했습니다.";
        }
    }

    private string GetSectionDisplayName(string key)
    {
        return key switch
        {
            "hero" => "① 히어로 슬라이드",
            "vision" => "② 올해의 표어",
            "sermons" => "③ 말씀과 찬양",
            "quick" => "④ 바로가기",
            "media" => "⑤ 소개 영상",
            "pastor" => "⑥ 담임목사 인사말",
            "news" => "⑦ 교회 소식",
            "locate" => "⑧ 오시는 길",
            _ => key
        };
    }
}
