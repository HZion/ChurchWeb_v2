# Database Connection String
# Render PostgreSQL 사용 시:
ConnectionStrings__Default=Host=your-postgres-host;Port=5432;Database=your-db-name;Username=your-username;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

# 로컬 PostgreSQL 사용 시 (docker-compose의 postgres 컨테이너):
# ConnectionStrings__Default=Host=postgres;Port=5432;Database=churchweb;Username=postgres;Password=postgres

# PostgreSQL 컨테이너 설정 (로컬 개발용)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=churchweb

# File Uploads (Render Persistent Disk - 프로덕션 환경)
UPLOADS_PATH=/var/data/uploads

# DataProtection Keys (Render Persistent Disk - 프로덕션 환경)
DP_KEYS_PATH=/var/data/keys

# YouTube API (optional)
YouTube__ApiKey=

# Kakao Map API (optional)
KakaoMap__ApiKey=

# Environment
ASPNETCORE_ENVIRONMENT=Production
